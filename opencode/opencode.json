{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": true,
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  "shell": "pwsh",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".next/**",
      "*.log"
    ]
  },
  "share": "manual",
  "snapshot": true,
  "instructions": []
}
